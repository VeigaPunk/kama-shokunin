+    throw std::invalid_argument("streaming responses require the 'stream_options' object field");
+    throw std::invalid_argument("the 'logit_bias' map must contain integer token id keys");
+    throw std::invalid_argument("the 'grammar' field must be a non-empty string expression");
+    throw std::invalid_argument("the 'cache_prompt' field must be a boolean true or false");
+    throw std::invalid_argument("the 'frequency_penalty' field must be a number in range");
+    throw std::invalid_argument("the 'presence_penalty' field must be a number in range");
+    throw std::invalid_argument("the 'mirostat_tau' field must be a number greater than zero");
+    throw std::invalid_argument("the 'ignore_eos' field must be a boolean true or false");
+    throw std::invalid_argument("the 'max_probs' value must not exceed the server limit");
+    throw std::invalid_argument("the 'samplers' field must be a list of sampler names");
