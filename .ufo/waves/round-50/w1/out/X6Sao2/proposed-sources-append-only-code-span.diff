+def code_span_end(s, i):
+    r"""Index just past the code span opened by the backtick run at `i`, or -1.
+
+    A run of N backticks closes only at the next run of exactly N (CommonMark
+    0.31.2 6.2 inline code); a run with no such partner is literal text, not
+    an open span.
+    """
+    n = 0
+    while i + n < len(s) and s[i + n] == "`":
+        n += 1
+    k = i + n
+    while k < len(s):
+        if s[k] == "`":
+            m = 0
+            while k + m < len(s) and s[k + m] == "`":
+                m += 1
+            if m == n:
+                return k + m
+            k += m
+            continue
+        k += 1
+    return -1
+
