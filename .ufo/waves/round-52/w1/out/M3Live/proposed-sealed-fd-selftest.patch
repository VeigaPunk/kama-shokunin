+def _sealed_fd_selftest():
+    """Round 52 (seat M3Live mutation probe): the sealed-fd refusal paths are
+    invisible to the counter's positive replay, so the selftest exercises them
+    directly: a sealing-capable but unsealed memfd, a memfd sealed with a
+    single seal, an unsealable regular file and a plain path-backed image must
+    each be refused or honestly recorded."""
+    for seals_bit, tag in ((None, 'no seals (unsealed memfd)'),
+                           (1, 'F_SEAL_SEAL only')):
+        fd = os.memfd_create('kama-sealed-fd-selftest',
+                             os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
+        try:
+            os.write(fd, b'B' * 64)
+            if seals_bit is not None:
+                fcntl.fcntl(fd, 1033, seals_bit)   # F_ADD_SEALS
+            try:
+                sealed_fd(fd, hashlib.sha256(b'B' * 64).hexdigest(), 64)
+            except SetupError:
+                pass
+            else:
+                raise AssertionError('sealed_fd accepted a memfd with ' + tag)
+        finally:
+            os.close(fd)
+    with tempfile.TemporaryDirectory(prefix='kama-sealed-fd-selftest-') as d:
+        path = os.path.join(d, 'server')
+        with open(path, 'wb') as fh:
+            fh.write(b'C' * 64)
+        plain = os.open(path, os.O_RDONLY)
+        try:
+            try:
+                sealed_fd(plain, hashlib.sha256(b'C' * 64).hexdigest(), 64)
+            except SetupError:
+                pass
+            else:
+                raise AssertionError('sealed_fd accepted an unsealable regular file')
+        finally:
