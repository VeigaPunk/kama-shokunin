+class _CannedHandler(http.server.BaseHTTPRequestHandler):
+    """Local fake answering the request plane with canned bodies."""
+
+    def _send(self, status, payload):
+        b = json.dumps(payload).encode()
+        self.send_response(status)
+        self.send_header('Content-Type', 'application/json')
+        self.send_header('Content-Length', str(len(b)))
+        self.end_headers()
+        self.wfile.write(b)
+
+    def do_POST(self):
+        n = int(self.headers.get('Content-Length') or 0)
+        req = json.loads(self.rfile.read(n) or b'{}')
+        if self.path == '/tokenize':
+            return self._send(200, {'tokens': [1, 291, 280, 294, 262, 294, 353, 265]})
+        if 'prompt' not in req:
+            return self._send(400, {'error': {'code': 400,
+                'message': "key 'prompt' not found",
+                'type': 'invalid_request_error'}})
+        return self._send(200, {
+            'choices': [{'text': ' sat on the mat', 'index': 0,
+                         'logprobs': None, 'finish_reason': 'length'}],
+            'created': 1793227133, 'model': _CANNED['alias'],
+            'system_fingerprint': _CANNED['fp'], 'object': 'text_completion',
+            'usage': {'completion_tokens': 8, 'prompt_tokens': 8,
+                      'total_tokens': 16,
+                      'prompt_tokens_details': {'cached_tokens': 0}},
+            'id': 'chatcmpl-canned',
+            'timings': {'cache_n': 0, 'prompt_n': 8, 'predicted_n': 8,
+                        'predicted_ms': 1.16}})
+
+    def log_message(self, *a):
+        pass
+
+
+def _fingerprint_from_binary(server):
+    """The real binary's build/commit, read from its own --version."""
+    r = subprocess.run([server, '--version'], capture_output=True, text=True)
+    out = r.stdout + r.stderr
+    m = re.search(r'build (\d+), commit ([0-9a-f]+)', out)
+    return f'b{m.group(1)}-{m.group(2)}' if m else None
+
+
+def start_canned(server, alias):
+    _CANNED['alias'] = alias
+    _CANNED['fp'] = _fingerprint_from_binary(server)
+    srv = http.server.ThreadingHTTPServer(('127.0.0.1', 0), _CannedHandler)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    _CANNED['port'] = srv.server_address[1]
+    return srv
