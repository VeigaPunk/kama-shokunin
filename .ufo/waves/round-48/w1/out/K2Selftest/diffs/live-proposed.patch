+def _parser_provenance_selftest():
+    """Argparse-level provenance shape rules (K2Selftest): the four v4 flags come
+    together, https URLs, a safe member, the v5 pinned URL (commit in the path,
+    not only in a query string), and 64-hex digest normalization (uppercase
+    accepted, lowercased before recording)."""
+    p = build_parser()
+    base = ['--model', 'x.gguf', '--model-sha256', '0' * 64]
+    pin = 'https://huggingface.co/o/r/resolve/' + 'a' * 40 + '/m.gguf'
+    flags = ['--server-asset-url', 'https://x/a.tar.gz',
+             '--server-asset-sha256', '0' * 64,
+             '--server-member', 'bin/llama-server',
+             '--model-url', pin]
+
+    def expect_error(argv, fragment):
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err):
+            try:
+                p.parse_args(argv)
+            except SystemExit as exc:
+                if exc.code != 2:
+                    raise AssertionError(f'{fragment}: exit {exc.code}')
+            else:
+                raise AssertionError(f'{fragment}: no error')
+        if fragment not in err.getvalue():
+            raise AssertionError(f'{fragment}: message missing')
+
+    expect_error(base + ['--server-asset-url', 'https://x/a.tar.gz'],
+                 'must be given together')
+    expect_error(base + flags[:5], 'must be given together')
+    expect_error(base + ['--server-asset-url', 'http://x/a.tar.gz'] + flags[3:],
+                 'must be an https:// URL')
+    expect_error(base + flags[:3] + ['--model-url', 'file:///tmp/m.gguf'],
+                 'must be an https:// URL')
+    expect_error(base + flags[:3] + ['--server-member', '/bin/llama-server',
+                                     '--model-url', pin],
+                 'relative path without ..')
+    expect_error(base + flags[:3] + ['--server-member', 'bin/../llama-server',
+                                     '--model-url', pin],
+                 'relative path without ..')
+    expect_error(base + flags[:3] + ['--server-member', 'bin/llama-server',
+                                     '--model-url',
+                                     'https://huggingface.co/o/r/resolve/main/m.gguf',
+                                     '--server-archive', 'a.tar.gz'],
+                 'must be pinned')
+    expect_error(base + flags[:3] + ['--server-member', 'bin/llama-server',
+                                     '--model-url',
+                                     'https://huggingface.co/o/r/resolve/main/m.gguf?revision='
+                                     + 'a' * 40,
+                                     '--server-archive', 'a.tar.gz'],
