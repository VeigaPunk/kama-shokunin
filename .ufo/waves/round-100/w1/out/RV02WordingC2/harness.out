CASE X-204-router-on verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (other 2xx, line-only)
CASE X-201-router-on verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (other 2xx, line-only)
CASE X-301-router-on verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (other 3xx, line-only)
CASE X-304-router-on verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (other 3xx, line-only)
CASE X-400-router-on verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (other 4xx, line-only)
CASE X-404-router-on verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (other 4xx, line-only)
CASE X-418-router-on verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (other 4xx, line-only)
CASE X-501-router-on verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (other 5xx, line-only)
CASE X-502-router-on verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (other 5xx, line-only)
CASE X-500-router-off verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (off-body under 5xx; cells use on-body S2)
CASE X-100-then-200-on verdict=MODEL_OK reason=router-unloaded-autoload exit=0 (final 200 after interim; 'final' wording)
CASE X-100-then-hang verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (interim only then silence -> rc28)
CASE X-200-chunked-on verdict=MODEL_OK reason=router-unloaded-autoload exit=0 (chunked 200; cells always Content-Length)
CASE X-200-close-delimited-on verdict=MODEL_OK reason=router-unloaded-autoload exit=0 (no length, HTTP/1.0 style)
CASE X-200-chunked-oversize verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (chunked over 4MiB cap -> rc63 or size check)
CASE X-empty-reply verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (rc52; server accepts /props then closes silently)
CASE X-http09-body verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (body bytes, no status line; observe curl)
CASE X-malformed-statusline verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (observe curl rc)
CASE X-partial-transfer verdict=MODEL_UNLOADED reason=router-autoload-unread exit=2 (CL=100, 40 bytes, RST -> rc18)
