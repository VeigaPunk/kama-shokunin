### uname -r (kernel release: moves on a kernel package update)
$ uname -r
7.2.11-arch1-1
exit=0

### uname -v (kernel version build string: moves on a kernel package update)
$ uname -v
#1 SMP PREEMPT_DYNAMIC Fri, 16 Oct 2026 00:28:58 +0000
exit=0

### uname -n (nodename, not part of the triple)
$ uname -n
plazir27
exit=0

### manual: -s and -m field definitions (coreutils uname(1))
$ MANWIDTH=100 man 1 uname 2>/dev/null | sed -n '/-s, --kernel-name/,/-r, --kernel-release/p'
     -s, --kernel-name
            print the kernel name

     -n, --nodename
            print the network node hostname

     -r, --kernel-release
exit=0

### manual: os-release(5) ID definition (distro identifier, not kernel)
$ MANWIDTH=100 man 5 os-release 2>/dev/null | sed -n '/^     ID=/,/^$/p'
     ID=
         A lower-case string (no spaces or other characters outside of 0–9, a–z, ".", "_" and  "-")
         identifying  the operating system, excluding any version information and suitable for pro‐
         cessing by scripts or usage in generated filenames. If not set, a  default  of  "ID=linux"
         may  be  used.  Note  that even though this string may not include characters that require
         shell quoting, quoting may nevertheless be used.

exit=0

