+    git(fx.fleet, "mv", "old/kama.md", REL)
+    git(fx.fleet, "-c", "commit.gpgsign=false", "commit", "-q", "--no-verify",
+        "-m", "round-1: move report", env=ident("fleet", 2500))
+    git(fx.fleet, "config", "log.follow", "true")
