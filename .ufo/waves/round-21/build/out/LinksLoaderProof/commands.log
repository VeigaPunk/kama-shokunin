$ sed -n 178,226p /tmp/kama-r21-LinksLoaderProof/lane/tools/kama-llamacpp-live.py
def install_tree(server_real):
    """{basename: sha256} for every regular file in dirname(server_real),
    plus a combined digest over the sorted 'name sha' lines. Symlinks are
    skipped as members (they are not regular files)."""
    tree = {}
    directory = os.path.dirname(server_real)
    try:
        entries = sorted(os.listdir(directory))
    except OSError:
        return tree, None
    for name in entries:
        full = os.path.join(directory, name)
        try:
            st = os.lstat(full)
        except OSError:
            continue
        if not stat.S_ISREG(st.st_mode):
            continue
        try:
            tree[name] = sha256_file(full)
        except OSError:
            continue
    combined = hashlib.sha256(
        ''.join(f'{n} {tree[n]}\n' for n in sorted(tree)).encode()).hexdigest()
    return tree, combined


def install_links(server_real):
    """{basename: link text} for every symlink in dirname(server_real), plus
    a combined digest over the sorted 'name -> text' lines. install_tree()
    skips symlinks, so a retargeted soname link (libllama.so.0 -> ...) would
    otherwise leave every pin unchanged. Link text is recorded unresolved;
    the gate checks that each chain ends at a pinned regular member."""
    links = {}
    directory = os.path.dirname(server_real)
    try:
        entries = sorted(os.listdir(directory))
    except OSError:
        return links, None
    for name in entries:
        full = os.path.join(directory, name)
        try:
            if stat.S_ISLNK(os.lstat(full).st_mode):
                links[name] = os.readlink(full)
        except OSError:
            continue
    combined = hashlib.sha256(''.join(
        f'{n} -> {links[n]}\n' for n in sorted(links)).encode()).hexdigest()
    return links, combined
[exit 0]

