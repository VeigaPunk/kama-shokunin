$ git -C /fast/scratch/hyaku/kama-r73/LAB01Probes/h1/parent/mod checkout -- base.txt
  (no output)
[exit=0]

[B1] parent, default ignore policy
$ git -C /fast/scratch/hyaku/kama-r73/LAB01Probes/h1/parent status --porcelain -uall
