{
  "c1": {
    "file": "tools/error-verdict-census.py",
    "lines_target": 200,
    "flags": ["--cells", "--lane", "--frozen-rev", "--json", "--selftest"],
    "flags_cut": ["--current-only", "--frozen-only", "--verbose", "--parallel"],
    "registry_fields": ["id", "instrument", "mode", "inject", "argv", "expected_class", "parser_id"],
    "parser_ids": ["gate_invalid_prefix", "grid_status", "citation_counts", "survivors_selftest"]
  },
  "c2": {
    "file": "tools/gguf-identity.py",
    "lines_target": 280,
    "flags": ["FILE", "--json", "--receipt", "--selftest"],
    "flags_cut": ["--max-kv", "--max-str", "--dump-all-keys", "--host-census"],
    "identity_keys": [
      "general.architecture",
      "general.name",
      "<arch>.context_length",
      "<arch>.block_count",
      "<arch>.embedding_length",
      "general.file_type",
      "general.alignment",
      "tokenizer.ggml.model"
    ]
  }
}
