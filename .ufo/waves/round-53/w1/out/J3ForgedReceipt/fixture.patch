+def _exec_segment(fh):
+    """(file offset, file size) of the first PT_LOAD program header whose flags carry PF_X
+    in a 64-bit little-endian ELF; raises Refused otherwise."""
+    def read_at(at, n):
+        fh.seek(at)
+        b = fh.read(n)
+        if len(b) != n:
+            raise Refused(f"elf-truncated:{n}@{at}")
+        return b
+    ident = read_at(0, 16)
+    if ident[:4] != b"\x7fELF" or ident[4] != 2 or ident[5] != 1:
+        raise Refused("elf-not-elf64-le")
+    e_phoff = int.from_bytes(read_at(32, 8), "little")
+    e_phentsize = int.from_bytes(read_at(54, 2), "little")
+    e_phnum = int.from_bytes(read_at(56, 2), "little")
+    if e_phentsize < 56:
+        raise Refused(f"elf-phdr-size:{e_phentsize}")
+    for i in range(e_phnum):
+        ph = read_at(e_phoff + i * e_phentsize, 56)
+        p_type = int.from_bytes(ph[0:4], "little")
+        p_flags = int.from_bytes(ph[4:8], "little")
+        if p_type == 1 and p_flags & 0x1:  # PT_LOAD with PF_X
+            return (int.from_bytes(ph[8:16], "little"),      # p_offset
+                    int.from_bytes(ph[32:40], "little"))     # p_filesz
+    raise Refused("elf-no-exec-segment")
+
+
+# The r-x PT_LOAD of this archive's libggml-rpc.so opens with .init/.plt/.plt.sec, so
+# +0x800 into the segment lands in the PLT (a corrupted stub could break a call); this
+# delta lands inside .text.
+FLIP_DELTA = 0x1d000
+
+
+def flip_unpacked_library(tree, member, delta=FLIP_DELTA):
+    """Ablation control (round 53, seat J3ForgedReceipt): after the member was checked and
+    extracted, flip one byte inside the first executable PT_LOAD of an unpacked library the
+    CPU path never executes (libggml-rpc.so is mapped by the server and its RPC path is not
+    used), so what the server executes is no longer the archive member's bytes while a
+    receipt that names the member's digest still verifies. Returns the flip record."""
+    path = os.path.join(tree, member)
+    with open(path, "r+b") as fh:
+        off, filesz = _exec_segment(fh)
+        at = off + delta if filesz > delta + 1 else off + max(1, filesz // 2)
+        fh.seek(at)
+        old = fh.read(1)
+        if not old:
+            raise Refused(f"flip-beyond-segment:{member}:{at}")
+        new = bytes([old[0] ^ 0x01])
+        fh.seek(at)
+        fh.write(new)
+        fh.flush()
+        os.fsync(fh.fileno())
+    return {"member": member, "path": path, "offset": at, "segment_offset": off,
+            "filesz": filesz, "was": old.hex(), "now": new.hex()}
+
+
 F_ADD_SEALS, F_GET_SEALS = 1033, 1034   # F_LINUX_SPECIFIC_BASE + 9, + 10 (fcntl(2))
 SEALS_ALL = 15                          # F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE
 
