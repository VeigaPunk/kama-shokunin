# pipe-exit repro (round 67 lesson Mistake 2): the status after a pipe is the filter's, not the instrument's
# the tool is untracked at this point (pre-commit), so the graded verdict is UNTRACKED, exit 1
$ python tools/round67-worktree-landing-check.py --paths tools/round67-worktree-landing-check.py | tail -1; echo $?
WORKTREE_LANDING_CHECK paths=1 clean=0 dirty=0 missing=0 untracked=1 unreadable=0
piped-status=0
$ python tools/round67-worktree-landing-check.py --paths tools/round67-worktree-landing-check.py > /dev/null; echo $?
direct-exit=1
