+def check_content_complete(repo):
+    """Refuse a repository whose reachable objects are not all present.
+
+    `rev-list --objects --all --missing=print` lists every object reachable
+    from every ref and names the ones it cannot find as ?<oid>. The audit
+    runs git with --no-lazy-fetch, so a promisor remote is never contacted
+    and a missing object stays missing.
+    """
+    out = git(repo, "rev-list", "--objects", "--all", "--missing=print")
+    missing = [line[1:] for line in out.split("\n") if line.startswith("?")]
+    if missing:
+        raise EvalError(f"{repo}: partial clone with missing objects "
+                        f"({len(missing)} missing)")
 
 
