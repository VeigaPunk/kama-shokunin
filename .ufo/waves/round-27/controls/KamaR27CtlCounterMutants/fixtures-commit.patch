+
+
+def finish(receipt: dict, out: str | None) -> int:
+    if out:
+        Path(out).write_text(json.dumps(receipt, indent=1, sort_keys=True) + "\n", "utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
