+        payload_file = tmp_path / "payload.json"
+        probe.write_text(
+            f"cat {shlex.quote(str(payload_file))}\nexit 2\n",
+            encoding="utf-8")
+        entry = {"test": dict(SELFTEST_VALID_TEST), "source": "<selftest>"}
+        real_bind_closed_port = bind_closed_port
+        bind_closed_port = lambda: 0
