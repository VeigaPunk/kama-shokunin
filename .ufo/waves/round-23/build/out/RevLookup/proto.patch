+def lookup(repos, tokens, peel=""):
+    """{token: 'found'|'ambiguous'|'missing'}. Ambiguity is read from the bare
+    name in each repo and is sticky: neither a peel nor another repo can
+    erase it."""
+    tokens = sorted(set(tokens))
+    status = {t: "missing" for t in tokens}
+    if not tokens:
+        return status
+    ambiguous = set()
+    for repo in repos:
+        bare = _probe(repo, tokens, "")
+        ambiguous.update(t for t, s in bare.items() if s == "ambiguous")
+        seen = _probe(repo, tokens, peel) if peel else bare
+        for token, state in seen.items():
+            if state == "found":
+                status[token] = "found"
+    for token in ambiguous:
