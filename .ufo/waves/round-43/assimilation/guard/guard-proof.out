# Guard proof — 0-3-space vs column-zero row patterns (observed transcript)
# commands run from /fast/scratch/kama-r43/clone (read-only) and the seat output dir

$ grep -oE "^|[[:space:]]*S[0-9]{3,}" guard/fixture-registry.md | grep -oE "S[0-9]+" | sort   # (column-zero pattern, literal ^|)
