+
+def git_show(repo: str, rev: str, path: str) -> str | None:
+    r = subprocess.run(["git", "-C", repo, "show", f"{rev}:{path}"],
+                       capture_output=True, timeout=60)
+    return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else None
+
