match    S038 asset name == archive basename
match    S038 size == archive size
match    S038 digest == archive sha256
match    archive members only in archive
match    installed entries not in archive
match    members whose bytes/target differ
match    archive-derived tree digest == installed tree digest
match    receipt install_tree == installed tree
match    receipt install_tree_sha256 == installed tree digest
match    receipt server.sha256 == installed llama-server
match    receipt server_impl_sha256 == installed libllama-server-impl.so
match    S039 size == model size
match    S039 LFS sha256 == model sha256
match    receipt model.path == model path
match    receipt model.sha256 == model sha256
match    receipt model_sha256_post == model sha256
