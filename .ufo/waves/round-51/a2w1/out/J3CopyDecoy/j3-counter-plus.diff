+# -------------------------------- proposed own-leg widening (round-51 J3CopyDecoy limit probe)
+# The `own` leg compares the dev and inode of the running image with <work>/server/<member>.
+# A byte-identical copy written over that member in place keeps path, digest and inode, so the
+# leg cannot see it (seat J3CopyDecoy: met=True with exactly that decoy). Its write history is
+# what differs, and an inotify watch on the member's directory sees it without the archive:
+# extraction creates the member once and completes one write; the decoy adds a second
+# write completion for the same basename (lab: create=1 close_write=1 vs close_write=2).
+IN_CLOSE_WRITE, IN_MOVED_TO, IN_CREATE = 0x8, 0x80, 0x100
+WATCH_MASK = IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE
+_LIBC = ctypes.CDLL("libc.so.6", use_errno=True)
+
+
+class MemberWrites:
+    """inotify watch on one directory, counting write completions of one basename."""
+
+    def __init__(self, directory, basename):
+        self.basename, self.seen = basename, []
+        self.fd = _LIBC.inotify_init1(os.O_NONBLOCK)
+        if self.fd < 0:
+            raise OSError(ctypes.get_errno(), "inotify_init1")
+        self.wd = _LIBC.inotify_add_watch(self.fd, os.fsencode(directory), WATCH_MASK)
+        if self.wd < 0:
+            raise OSError(ctypes.get_errno(), f"inotify_add_watch {directory}")
+
+    def counts(self):
+        while True:
+            try:
+                buf = os.read(self.fd, 65536)
+            except BlockingIOError:
+                break
+            if not buf:
+                break
+            off = 0
+            while off < len(buf):
+                _wd, mask, _cookie, ln = struct.unpack_from("iIII", buf, off)
+                off += 16
+                name = buf[off:off + ln].split(b"\0", 1)[0].decode("utf-8", "replace")
+                off += ln
+                self.seen.append((name, mask))
+        ev = [m for n, m in self.seen if n == self.basename]
+        write = [m for m in ev if m & (IN_CREATE | 0x2 | IN_CLOSE_WRITE | IN_MOVED_TO)]
+        first_close = next((i for i, m in enumerate(write) if m & IN_CLOSE_WRITE), None)
+        return {"create": sum(1 for m in ev if m & IN_CREATE),
+                "moved_to": sum(1 for m in ev if m & IN_MOVED_TO),
+                "close_write": sum(1 for m in write if m & IN_CLOSE_WRITE),
+                "late": 0 if first_close is None else len(write) - first_close - 1}
+
+    def close(self):
+        try:
+            os.close(self.fd)
+        except OSError:
+            pass
+
+
