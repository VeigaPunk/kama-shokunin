+def git_env(**extra):
+    """Environment for every git child process.
+
+    Drops inherited GIT_* (repository pointers, config, templates, hash) and
+    switches user and system config off, so each call sees exactly the
+    repository it was given.
+    """
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
+    env.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1", **extra)
+    return env
+
