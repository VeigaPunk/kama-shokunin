+def _model_fetch_selftest():
+    """Exercise --model-url acquisition without a server: file:// and
+    loopback-http fetch, redirect hops, digest/no-pin/scheme/target/parent
+    refusals, TMPDIR staging cleanup and the cross-device publish path."""
+    import http.server
+    import threading
+
+    payload = b'GGUF-selftest\n' + bytes(range(256)) * 4
+    digest = hashlib.sha256(payload).hexdigest()
+    stage_root = tempfile.mkdtemp(prefix='kama-fetch-stage-')
+    staging = os.path.join(stage_root, 'tmp')   # TMPDIR seen by the fetch
+    os.mkdir(staging)
+    previous_tempdir = tempfile.tempdir
+    tempfile.tempdir = staging
+    try:
+        def leftovers():
+            return sorted(os.listdir(staging))
+
+        def refused(want, call):
+            try:
+                call()
+            except SetupError as exc:
+                if exc.code != want and not exc.code.startswith(want + ':'):
+                    raise AssertionError(
+                        'model fetch refusal '
+                        f'{exc.code!r} != {want!r}') from exc
+                return
+            raise AssertionError(f'model fetch refusal {want!r} not raised')
+
+        with tempfile.TemporaryDirectory(prefix='kama-fetch-dst-',
+                                         dir=stage_root) as dest:
+            source = os.path.join(dest, 'source.gguf')
+            with open(source, 'wb') as fh:
+                fh.write(payload)
+            source_url = Path(source).as_uri()
+            target = os.path.join(dest, 'cache', 'model.gguf')
+            os.mkdir(os.path.dirname(target))
+
+            # 1. file:// success: digest proven, verified bytes staged in
+            #    TMPDIR (never at the target), uppercase pin accepted.
+            staging_seen = {}
+            original_publish = globals()['_publish_model']
+
+            def recording_publish(staged_path, final_path):
+                staging_seen['dir'] = os.path.dirname(
+                    os.path.abspath(staged_path))
+                staging_seen['size'] = os.path.getsize(staged_path)
+                return original_publish(staged_path, final_path)
+
+            globals()['_publish_model'] = recording_publish
+            try:
+                record = fetch_model(source_url, target, digest.upper())
+            finally:
+                globals()['_publish_model'] = original_publish
+            if staging_seen.get('dir') != os.path.abspath(staging):
+                raise AssertionError(
+                    f'fetch did not stage in TMPDIR: {staging_seen!r}')
+            if staging_seen.get('size') != len(payload):
+                raise AssertionError(
+                    f'staged body size wrong: {staging_seen!r}')
+            with open(target, 'rb') as fh:
+                if fh.read() != payload:
+                    raise AssertionError('file:// fetch body mismatch')
+            if record['sha256'] != digest or record['bytes'] != len(payload):
+                raise AssertionError(
+                    f'file:// fetch record wrong: {record!r}')
+            if record['url_final'] != source_url or record['redirects']:
+                raise AssertionError(
+                    f'file:// fetch provenance wrong: {record!r}')
+            if leftovers():
+                raise AssertionError('file:// fetch left staging files')
+
+            # 2. An existing target is never clobbered by a fetch.
+            refused('model-fetch-target-exists',
+                    lambda: fetch_model(source_url, target, digest))
+            with open(target, 'rb') as fh:
+                if fh.read() != payload:
+                    raise AssertionError('existing target was modified')
+
+            # 3. A wrong pin leaves no file and cleans staging.
+            wrong = os.path.join(dest, 'cache', 'wrong.gguf')
+            refused('model-fetch-digest-mismatch',
+                    lambda: fetch_model(source_url, wrong, '0' * 64))
+            if os.path.exists(wrong) or leftovers():
+                raise AssertionError('digest mismatch left a file behind')
+
+            # 4. No pin, no fetch: the pin is the authority, not the URL.
+            for pin in (None, '', 'deadbeef', digest + 'ff'):
+                no_pin = os.path.join(dest, 'cache', 'no-pin.gguf')
+                refused('model-fetch-no-pin',
+                        lambda pin=pin: fetch_model(source_url, no_pin, pin))
+                if os.path.exists(no_pin):
+                    raise AssertionError('unpinned fetch created the target')
+
+            # 5. Scheme and parent preconditions refuse before any transfer.
+            refused('model-fetch-scheme',
+                    lambda: fetch_model('ftp://127.0.0.1/model.gguf',
+                                        os.path.join(dest, 'cache', 'x.gguf'),
+                                        digest))
+            refused('model-fetch-parent-missing',
+                    lambda: fetch_model(source_url,
+                                        os.path.join(dest, 'absent', 'm.gguf'),
+                                        digest))
+
+            # 6. Cross-device publish falls back to a sibling temp.
+            staged = os.path.join(staging, 'staged.bin')
+            with open(staged, 'wb') as fh:
+                fh.write(payload)
+            crossing = os.path.join(dest, 'crossed.bin')
+            original_replace = os.replace
+            state = {'first': True}
+
+            def crossing_replace(src, dst):
+                if state['first']:
+                    state['first'] = False
+                    raise OSError(errno.EXDEV, 'cross-device-selftest')
+                return original_replace(src, dst)
+
+            os.replace = crossing_replace
+            try:
+                _publish_model(staged, crossing)
+            finally:
+                os.replace = original_replace
+            with open(crossing, 'rb') as fh:
+                if fh.read() != payload or os.path.exists(staged):
+                    raise AssertionError('cross-device publish failed')
+            if [name for name in os.listdir(dest)
+                    if name.startswith('.kama-model-fetch-')]:
+                raise AssertionError(
+                    'cross-device publish left a sibling temp')
+
+            # 7. Loopback http: redirect recorded, 404 refused, staging clean.
+            class Handler(http.server.BaseHTTPRequestHandler):
+                def do_GET(self):
+                    if self.path == '/redirect':
+                        self.send_response(302)
+                        self.send_header('Location', '/model.gguf')
+                        self.end_headers()
+                        return
+                    if urllib.parse.urlsplit(self.path).path != '/model.gguf':
+                        self.send_error(404)
+                        return
+                    self.send_response(200)
+                    self.send_header('Content-Length', str(len(payload)))
+                    self.end_headers()
+                    self.wfile.write(payload)
+
+                def log_message(self, *_args):
+                    pass
+
+            server = http.server.ThreadingHTTPServer(
+                ('127.0.0.1', 0), Handler)
+            thread = threading.Thread(target=server.serve_forever,
+                                      daemon=True)
+            thread.start()
+            try:
+                base = f'http://127.0.0.1:{server.server_address[1]}'
+                http_target = os.path.join(dest, 'cache', 'http.gguf')
+                http_record = fetch_model(base + '/redirect', http_target,
+                                          digest)
+                if http_record['url_final'] != base + '/model.gguf' or not (
+                        http_record['redirects']):
+                    raise AssertionError(
+                        f'http redirect not recorded: {http_record!r}')
+                with open(http_target, 'rb') as fh:
+                    if fh.read() != payload:
+                        raise AssertionError('http fetch body mismatch')
+                token_target = os.path.join(dest, 'cache', 'token.gguf')
+                token_record = fetch_model(
+                    base + '/model.gguf?token=selftest-secret',
+                    token_target, digest)
+                if 'selftest-secret' in json.dumps(token_record) or not (
+                        token_record['url_redacted']):
+                    raise AssertionError(
+                        'signed URL leaked into the fetch record: '
+                        f'{token_record!r}')
+                if token_record['url'] != base + '/model.gguf':
+                    raise AssertionError(
+                        f'redacted URL wrong: {token_record["url"]!r}')
+                with open(token_target, 'rb') as fh:
+                    if fh.read() != payload:
+                        raise AssertionError('token fetch body mismatch')
+                gone = os.path.join(dest, 'cache', 'gone.gguf')
+                refused('model-fetch-http:404',
+                        lambda: fetch_model(base + '/missing', gone, digest))
+                if os.path.exists(gone):
+                    raise AssertionError('404 fetch created the target')
+            finally:
+                server.shutdown()
+                server.server_close()
+                thread.join(timeout=5)
+            if leftovers():
+                raise AssertionError('http fetch left staging files')
+
+            # 8. redact_url drops credentials, query and fragment.
+            if redact_url('https://user:pw@host:8443/m.gguf?a=1#frag') != (
+                    'https://host:8443/m.gguf'):
+                raise AssertionError(
+                    'redact_url kept credentials/query/fragment')
+            if redact_url('not a url') != '<unparsed>' or redact_url(
+                    None) is not None:
+                raise AssertionError('redact_url edge cases')
+
+            # 9. The CLI accepts --model-url and keeps it optional.
+            parser = build_parser()
+            if parser.parse_args(
+                    ['--model', 'm', '--model-sha256', digest]
+            ).model_url is not None:
+                raise AssertionError('--model-url is not optional')
+            parsed = parser.parse_args(
+                ['--model', 'm', '--model-sha256', digest,
+                 '--model-url', source_url])
+            if parsed.model_url != source_url:
+                raise AssertionError('--model-url not parsed')
+    finally:
+        tempfile.tempdir = previous_tempdir
+        shutil.rmtree(stage_root, ignore_errors=True)
+
