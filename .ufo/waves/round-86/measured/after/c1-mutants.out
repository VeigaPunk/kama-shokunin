$ for m in a-fence-off b-comment-off c-correction-off d-authority-indent d2-row-indent f-tilde-off e-coupling-off; do python3 <mutant>.py --selftest; done
# each mutant is one contiguous source edit of tools/round86-rendered-cells.py at the frozen
# freeze bytes; every mutant must turn its own declared arm red.
a-fence-off: exit=1 red_arms=fenced-shadow,tilde-fence-shadow,unclosed-fence-fails-closed
b-comment-off: exit=1 red_arms=comment-shadow
c-correction-off: exit=1 red_arms=correction-shadow
d-authority-indent: exit=1 red_arms=indent-shadow
d2-row-indent: exit=1 red_arms=indent-row-shadow
f-tilde-off: exit=1 red_arms=tilde-fence-shadow
e-coupling-off: exit=1 red_arms=contradictory-receipt,revision-carries-no-receipt
RENDERED_CELLS_MUTANTS mutants=7 killed=7 escaped=0
