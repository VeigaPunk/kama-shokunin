             if f not in changed:
                 continue
             d = _git(repo_path, "diff", "--no-renames", "--no-color", "--no-ext-diff", "-U0", p, c, "--", f)
-            dele = [x[1:] for x in d.split("\n") if x.startswith("-") and not x.startswith("---")]
+            # Count deletions only inside hunks: the `--- a/<path>` header precedes the
