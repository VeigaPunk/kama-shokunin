+def live_lines(text):
+    """Lines of `text` outside fenced code blocks and HTML comments.
+
+    Lines inside a fenced block (opening fence of three or more backticks or
+    tildes, closed by a fence of the same character and at least the same
+    length) and lines inside a multi-line `<!-- ... -->` comment are not
+    Markdown headings: the append-only audit restores deleted SCORECARD blocks
+    verbatim inside such fences, so scanning the raw text lets a stale
+    historical heading inflate every value keyed off it.
+    """
+    out, fence, comment = [], None, False
+    for l in text.split("\n"):
+        if comment:
+            if "-->" in l:
+                comment = False
+            continue
+        if fence is None:
+            stripped = l.lstrip()
+            if stripped.startswith("<!--"):
+                if "-->" not in stripped[4:]:
+                    comment = True
+                continue
+            m = re.match(r"^ {0,3}(`{3,}|~{3,})", l)
+            if m:
+                fence = (m.group(1)[0], len(m.group(1)))
+                continue
+            out.append(l)
+        else:
+            m = re.match(r"^ {0,3}(`{3,}|~{3,})\s*$", l)
+            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= fence[1]:
+                fence = None
+    return out
+
