== parse_lora_request @release
   298	std::map<int, float> parse_lora_request(const json & data) {
   299	    std::map<int, float> lora;
   300	
   301	    // set value
   302	    for (const auto & entry : data) {
   303	        int id      = json_value(entry, "id", -1);
   304	        float scale = json_value(entry, "scale", 0.0f);
   305	        lora[id] = scale;
   306	    }
   307	
   308	    return lora;
   309	}
== add_preserved_tokens @release common/sampling.cpp
  1055	void common_sampling_add_preserved_tokens(common_params_sampling & sampling, const llama_vocab * vocab, const std::vector<std::string> & tokens) {
  1056	    GGML_ASSERT(vocab != nullptr);
  1057	    for (const auto & t : tokens) {
  1058	        auto ids = common_tokenize(vocab, t, false, true);
  1059	        if (ids.size() == 1) {
  1060	            sampling.preserved_tokens.insert(ids[0]);
  1061	        }
  1062	    }
  1063	}
