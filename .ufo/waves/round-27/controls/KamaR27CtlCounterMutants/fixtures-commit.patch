+MODEL_SHA256 = "270cba1bd5109f42d03350f60406024560464db173c0e387d91f0426d3bd256d"
+COMMIT = "704366d"
+SOURCE_DIR = ".ufo/waves/round-27/sources/llama.cpp-704366d"
+SOURCE_SHA256 = {
