# integration hardening (wave seats V1Review, V3Review, J4OmitLib): each new check removed alone; the matching new selftest case must fail
$ python3 <tools/kama-live-replay.py with mut-a-no-path-check> --selftest --scratch <dir>
FAIL code-path-missing: exit=0 refused=None mism=[]
KLR_SELFTEST pass=45 fail=1
exit=1
$ python3 <tools/kama-live-replay.py with mut-b-any-memfd> --selftest --scratch <dir>
FAIL code-foreign-memfd: exit=0 refused=None mism=[]
KLR_SELFTEST pass=45 fail=1
exit=1
$ python3 <tools/kama-live-replay.py with mut-c-no-required> --selftest --scratch <dir>
FAIL code-required-absent: exit=0 refused=None mism=[]
KLR_SELFTEST pass=45 fail=1
exit=1
$ python3 tools/kama-live-replay.py --selftest --scratch <dir>  (integrated)
KLR_SELFTEST pass=46 fail=0
exit=0
