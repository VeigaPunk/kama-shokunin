# KQ151 twin-label check at ee19acbdabc8ac572e82ae56459c364457895b06: P-rows of §Listen port and slot-count setters grouped by text cell; a group whose (parameter, effect) labels differ is printed
# cmd: git show ee19acbdabc8ac572e82ae56459c364457895b06:SKILL.md | python3 <inline twin grouper below>
TWIN_LABEL_DIFF `{"-np", "--parallel"}, "N",` [('P02', 'n_parallel', 'declares'), ('P05', '-', 'unrelated')]
TWIN_LABEL_DIFF `params.n_parallel = value;` [('P03', 'n_parallel', 'overrides'), ('P06', '-', 'unrelated')]
TWIN_LABEL_DIFF `int port = 0;` [('P40', '-', 'unrelated'), ('P46', 'port', 'default')]
KQ151_TWINS groups=7 label_diffs=3
exit=1
