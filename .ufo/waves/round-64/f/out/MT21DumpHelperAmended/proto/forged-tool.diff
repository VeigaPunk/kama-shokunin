+        except OSError:
+            continue
+        if tgt.startswith('socket:[') and tgt[8:-1] in inodes:
+            pfd = os.pidfd_open(pid)
+            try:
+                nfd = libc.syscall(ctypes.c_long(438), ctypes.c_int(pfd),
