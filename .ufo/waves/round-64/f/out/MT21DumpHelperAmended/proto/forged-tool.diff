+def _forge_cmd(conn, data, fds=()):
+    if fds:
+        socket.send_fds(conn, [data], list(fds))
+    else:
+        conn.sendall(data)
+    buf = b''
+    while not buf.endswith(b'\n'):
+        d = conn.recv(64)
+        if not d:
+            raise RuntimeError('helper closed control socket')
+        buf += d
