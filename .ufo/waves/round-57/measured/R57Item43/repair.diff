+def derive_maxn(text):
+    """Canonical heading semantics, unchanged: greatest N over `^## Round (\\d+)`.
+
+    Returns (maxn, headings); `headings` is the number of round headings the
+    call actually read - the execution witness a literal summary cannot supply.
+    """
+    rounds = [int(m.group(1)) for l in text.split("\n") for m in [ROUND_RE.match(l)] if m]
+    if not rounds:
+        raise ValueError("no `## Round N` heading in SCORECARD.md")
+    return max(rounds), len(rounds)
 
 
