+def witness_dir_problems(wdir):
+    """Round 49 host-safety (seat Sen1Witness): the witness directory is an
+    operator-chosen write target whose contents steer an outside observer, so
+    a directory another account can write must be refused: a planted `release`
+    ends the hold before anything is observed, a planted `ready.json.tmp`
+    symlink redirects the announcement write into any file this user can write,
+    and a planted `ready.json` is what a poller reads before the rerun is
+    ready. A pre-existing announcement or release is refused for the same
+    reason: it names a dead or foreign server."""
+    problems = []
+    try:
+        st = os.stat(wdir)
+    except OSError as exc:
+        return ['unstatable:' + (exc.strerror or type(exc).__name__)]
+    if st.st_uid != os.geteuid():
+        problems.append('not-owned-by-euid')
+    if st.st_mode & 0o022:
+        problems.append('group-or-other-writable')
+    try:
+        names = sorted(os.listdir(wdir))
+    except OSError as exc:
+        problems.append('unlistable:' + (exc.strerror or type(exc).__name__))
+        names = []
+    for name in names:
+        if name in ('ready.json', 'release') \
+                or (name.startswith('ready.') and name.endswith('.json.tmp')):
+            problems.append('stale:' + name)
+    return problems
+
+
+def _write_ready(wdir, ready):
+    """Publish the announcement without following anything already at the
+    temp name: O_CREAT|O_EXCL|O_NOFOLLOW under a per-pid name, mode 0600 (the
+    file names the port of a server that has no authentication)."""
+    tmp = os.path.join(wdir, 'ready.%d.json.tmp' % os.getpid())
+    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    try:
+        with os.fdopen(fd, 'w') as fh:
+            json.dump(ready, fh)
+        os.replace(tmp, os.path.join(wdir, 'ready.json'))
+    except BaseException:
+        try:
+            os.unlink(tmp)
+        except OSError:
+            pass
+        raise
+
+
+def _released(release, announced_ns):
+    """Only a regular file created after the announcement releases the hold: a
+    pre-existing file (a reused witness directory), a directory, a FIFO or a
+    dangling symlink must not."""
+    try:
+        st = os.lstat(release)
+    except OSError:
+        return False
+    return stat.S_ISREG(st.st_mode) and st.st_mtime_ns >= announced_ns
+
+
