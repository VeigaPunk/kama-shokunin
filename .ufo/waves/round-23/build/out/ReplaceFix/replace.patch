+def refuse_grafts(repo):
+    """`info/grafts` rewrites commit parents for every history walk, and
+    --no-replace-objects covers replace refs only, so the walk would not be
+    the committed history. Refuse rather than audit it."""
+    rel = git(repo, "rev-parse", "--git-path", "info/grafts").strip()
+    if os.path.lexists(Path(repo) / rel):
+        raise EvalError(f"{repo}: {rel} rewrites commit parents; history is "
+                        "not the committed graph")
+
+
