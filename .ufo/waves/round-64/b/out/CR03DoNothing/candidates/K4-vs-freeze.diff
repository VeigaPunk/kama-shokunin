+def _spawn_second_holder(child_pid, port):
+    """Mutant K4: a sleeper process that inherits a dup of the child's run-port
+    listening socket (pidfd_getfd), so it is a second holder of that listener."""
+    import ctypes
+    inodes = {f'socket:[{i}]' for i in _live._listen_inodes(port)}
+    fd = None
+    for name in os.listdir(f'/proc/{child_pid}/fd'):
+        try:
+            if os.readlink(f'/proc/{child_pid}/fd/{name}') in inodes:
+                fd = int(name)
+                break
+        except OSError:
+            continue
+    if fd is None:
+        return None
+    pidfd = os.pidfd_open(child_pid)
+    newfd = ctypes.CDLL(None, use_errno=True).syscall(438, pidfd, fd, 0)
+    os.close(pidfd)
+    if newfd < 0:
+        return None
+    p = subprocess.Popen(
+        [sys.executable, '-c', 'import time; time.sleep(600)'],
+        pass_fds=(newfd,), stdin=subprocess.DEVNULL,
+        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    os.close(newfd)
+    return p
+
