+GREEN = {"bind": lambda v: v == "1", "sealed": lambda v: v == "1",
+         "code": lambda v: v == "1", "teardown": lambda v: v == "1",
+         "newrow": lambda v: v == "1", "rehash": lambda v: v == "0"}
