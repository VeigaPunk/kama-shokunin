+def pinned_sha(surface_text, token):
+    """The 64-hex SHA-256 a surface line states for `token`, if it pins one."""
+    for line in surface_text.split("\n"):
+        if f"`{token}`" in line:
+            m = re.search(r"\b[0-9a-f]{64}\b", line)
+            if m:
+                return m.group(0)
+    return None
+
