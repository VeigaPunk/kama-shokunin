+        # was written, must hash to the receipt's server - a short write would differ
+        hm, off, size = hashlib.sha256(), 0, os.fstat(fd).st_size
+        while off < size:
+            chunk = os.pread(fd, min(CHUNK, size - off), off)
+            if not chunk:
