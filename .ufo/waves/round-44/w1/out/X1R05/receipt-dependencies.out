    61	static server_http_context::handler_t ex_wrapper(server_http_context::handler_t func) {
    62	    return [func = std::move(func)](const server_http_req & req) -> server_http_res_ptr {
    63	        std::string message;
    64	        error_type error;
    65	        try {
    66	            return func(req);
    67	        } catch (const std::invalid_argument & e) {
    68	            // treat invalid_argument as invalid request (400)
    69	            error = ERROR_TYPE_INVALID_REQUEST;
    70	            message = e.what();
    71	        } catch (const common_json_error & e) {
    72	            // JSON parse and type errors are invalid requests (400)
