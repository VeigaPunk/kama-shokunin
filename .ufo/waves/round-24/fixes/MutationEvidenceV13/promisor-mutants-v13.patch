+def classify_row(row):
+    """How a violated row changed the audited outcome.
+
+    The classes are read from the row's own expected_exit and exit. An
+    exit pair alone never shows that the whole verdict changed: a 0 -> 0
+    or 1 -> 1 pair keeps the same exit and the detail may differ.
+
+    refusal-2        a normal verdict (expected 0 or 1) became a refusal:
+                     an over-refusal signal, NOT an availability credit
+    actual-verdict   an unavailable case (expected 2) became a real
+                     verdict: the availability credit
+    verdict-change   only 0 <-> 1: the verdict's pass/fail changed
+    same-verdict-exit  0 -> 0 or 1 -> 1: the same exit, the detail may
+                     differ; no substantive exit change and no availability
+                     claim
+    diagnostic-only   2 -> 2: the refusal stayed a refusal, so only the
+                     diagnostics can differ
+    unclassified     the comparison fields (expected_exit, exit) are
+                     missing or outside 0/1/2: no class credit is guessed
+    """
+    expected = row.get("expected_exit")
+    actual = row.get("exit")
+    if expected not in (0, 1, 2) or actual not in (0, 1, 2):
+        return "unclassified"
+    if expected in (0, 1) and actual == 2:
+        return "refusal-2"
+    if expected == 2 and actual in (0, 1):
+        return "actual-verdict"
+    if expected == actual:
+        return "diagnostic-only" if expected == 2 else "same-verdict-exit"
+    if expected in (0, 1) and actual in (0, 1):
+        return "verdict-change"
+    return "other"
+
