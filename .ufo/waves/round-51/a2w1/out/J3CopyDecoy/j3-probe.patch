+# ------------------------------------------------------------- round-51 limit probe (J3CopyDecoy)
+# The C1 counter's `own` leg compares the dev and inode of the running image with the
+# replay's extracted member <work>/server/<member>, and its bytes with the receipt's server
+# digest. A byte-identical copy of the host's b11909 install written over that member - same
+# bytes, same path, same inode (in-place truncate and write) - is therefore indistinguishable
+# from an extraction. This probe performs exactly that copy after extraction and records the
+# one observation that does distinguish it: the member's stat history (the tar header mtime
+# the extraction set, the mtime and ctime the copy overwrote them with). Markers go to
+# PROBE_DIR, outside the replay's work tree, so a counter that deletes its scratch keeps them.
+PROBE_DIR = "/fast/scratch/hyaku/kama-r51/J3CopyDecoy/markers"
+PROBE_HOST_SERVER = "/home/vgpnk/.local/opt/llama-b11909/llama-server"
+
+
+def _stat_brief(st):
+    return {"dev": "%02x:%02x" % (os.major(st.st_dev), os.minor(st.st_dev)),
+            "inode": str(st.st_ino), "size": st.st_size, "mode": oct(st.st_mode & 0o7777),
+            "mtime_ns": st.st_mtime_ns, "ctime_ns": st.st_ctime_ns}
+
+
+def probe_copy(server, archive, member):
+    """Overwrite the extracted member with the host install's bytes; return the record.
+    The extraction's tar-header mtime is read before the copy so the record carries both
+    what an honest replay leaves (header mtime) and what the copy leaves (now)."""
+    before = _stat_brief(os.stat(server))
+    header_ns = None
+    try:
+        with tarfile.open(archive) as tf:
+            hits = [m for m in tf.getmembers()
+                    if m.name == member or m.name.endswith("/" + os.path.basename(member))]
+        if hits:
+            header_ns = int(hits[0].mtime) * 1_000_000_000
+    except (OSError, tarfile.TarError):
+        pass
+    at_ns = time.time_ns()
+    shutil.copyfile(PROBE_HOST_SERVER, server)
+    after = _stat_brief(os.stat(server))
+    rec = {"probe": "round-51 J3CopyDecoy limit", "at_ns": at_ns, "host": PROBE_HOST_SERVER,
+           "member": server, "header_mtime_ns": header_ns, "before": before, "after": after,
+           "host_sha256": sha256_file(PROBE_HOST_SERVER), "member_sha256": sha256_file(server),
+           "same_inode": before["inode"] == after["inode"]}
+    try:
+        os.makedirs(PROBE_DIR, exist_ok=True)
+        with open(os.path.join(PROBE_DIR, f"probe-{os.getpid()}-{after['inode']}.json"), "w") as fh:
+            json.dump(rec, fh, indent=1, sort_keys=True)
+    except OSError:
+        pass
+    return rec
+
+
