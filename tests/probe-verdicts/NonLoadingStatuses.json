[
  {
    "name": "NonLoadingStatuses.ok200-json-envelope",
    "family": "NonLoadingStatuses",
    "why": "Exact llama.cpp loading envelope at HTTP 200 with JSON CT: no data/models array and status != 503, so classify() lands on 2xx+json -> schema-unrecognized.",
    "port_mode": "stub",
    "routes": {
      "/v1/models": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body_json": {"error": {"message": "Loading model", "type": "unavailable_error", "code": 503}}
      }
    },
    "default_route": null,
    "expect": "stories260K",
    "expected": {"verdict": "FOREIGN_SERVICE", "reason": "schema-unrecognized", "exit": 2}
  },
  {
    "name": "NonLoadingStatuses.ok200-plain-envelope",
