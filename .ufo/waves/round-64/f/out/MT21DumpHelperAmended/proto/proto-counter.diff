+def server_side_inodes(port, lport):
+    """inodes of the ESTABLISHED TCP rows whose local side is the run port
+    and whose remote side is this counter's client port: the accepted
+    socket that carried the answer (proc_net_tcp(5), state 01)."""
+    out = []
+    for path in ('/proc/net/tcp', '/proc/net/tcp6'):
+        try:
+            with open(path, encoding='ascii') as fh:
+                next(fh, None)
+                for line in fh:
+                    f = line.split()
+                    if len(f) < 10 or f[3] != '01':
+                        continue
+                    lp = int(f[1].rpartition(':')[2], 16)
+                    rp = int(f[2].rpartition(':')[2], 16)
+                    if lp == port and rp == lport:
+                        out.append(int(f[9]))
+        except (OSError, ValueError, IndexError):
+            continue
+    return out
+
+
+def conn_owner(port, timeout=5.0):
+    """Who answers one counter-owned keep-alive request on the run port:
+    the readable holders of the accepted socket that carried the request.
+    A hidden helper that accepted the connection holds that socket in a
+    non-dumpable fd table, so the answer shows no holder at all."""
+    out = {'inode': None, 'holders': []}
+    try:
+        s = socket.create_connection(('127.0.0.1', port), timeout=5.0)
+    except OSError:
+        return out
+    try:
+        lport = s.getsockname()[1]
+        try:
+            s.sendall(b'GET /health HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n')
+        except OSError:
+            pass
+        t0 = time.monotonic()
+        while time.monotonic() - t0 < timeout:
+            inos = server_side_inodes(port, lport)
+            if inos:
+                held, _unread = holder_pids(inos[:1])
+                if held:
+                    out['inode'] = inos[0]
+                    out['holders'] = sorted(held)
+                    break
+            time.sleep(0.05)
+    finally:
+        s.close()
+    return out
+
