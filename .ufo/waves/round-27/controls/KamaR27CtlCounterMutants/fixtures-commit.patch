+        text = (r.stdout + r.stderr).decode("utf-8", "replace")
+        if r.returncode != 0 or not text.strip():
+            raise CannotEvaluate(f"informational baseline {flag} exit {r.returncode}")
+        parts.append(text)
+    return "\n".join(parts)
