+def redact_url(url):
+    """Recordable form of a download URL: userinfo, query and fragment are
+    dropped, so a signed or tokenised URL never lands in a committed receipt.
+    The bytes are pinned by ``--model-sha256``, so scheme/host/path is the
+    identity a rerun needs."""
+    if not isinstance(url, str):
+        return None
+    parts = urllib.parse.urlsplit(url)
+    if not parts.scheme:
+        return '<unparsed>'
+    host = parts.hostname or ''
+    if ':' in host:                       # IPv6 literal keeps its brackets
+        host = f'[{host}]'
+    netloc = host if parts.port is None else f'{host}:{parts.port}'
+    return urllib.parse.urlunsplit(
+        (parts.scheme.lower(), netloc, parts.path, '', ''))
+
+
+class _FetchRedirects(urllib.request.HTTPRedirectHandler):
+    """Follow http(s) redirects, record every hop, and refuse a hop whose
+    scheme is not a download scheme (no ``file://`` escape out of http)."""
+
+    def __init__(self):
+        self.hops = []
+
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        scheme = urllib.parse.urlsplit(newurl).scheme.lower()
+        if scheme not in MODEL_FETCH_SCHEMES:
+            raise SetupError(f'model-fetch-redirect-scheme:{scheme}')
+        self.hops.append(newurl)
+        return super().redirect_request(req, fp, code, msg, headers, newurl)
+
+
+def _publish_model(staged, path):
+    """Publish a verified staging file at ``path`` without ever exposing a
+    partial file: one rename when staging and target share a filesystem,
+    else a sibling copy (same filesystem as the target) plus rename."""
+    directory = os.path.dirname(os.path.abspath(path))
+    try:
+        os.replace(staged, path)
+        return
+    except OSError as exc:
+        if exc.errno != errno.EXDEV:
+            raise
+    fd, sibling = tempfile.mkstemp(prefix='.kama-model-fetch-', dir=directory)
+    try:
+        with os.fdopen(fd, 'wb') as out, open(staged, 'rb') as src:
+            for chunk in iter(lambda: src.read(MODEL_FETCH_CHUNK), b''):
+                out.write(chunk)
+            out.flush()
+            os.fsync(out.fileno())
+        os.replace(sibling, path)
+    except BaseException:
+        try:
+            os.unlink(sibling)
+        except OSError:
+            pass
+        raise
+    try:
+        os.unlink(staged)
+    except OSError:
+        pass          # the target is already published; staging is litter only
+
+
+def fetch_model(url, path, expected_sha):
+    """Fetch ``url`` to ``path`` and prove it against ``expected_sha``.
+
+    Called only for a missing ``--model`` path, and never without a 64-hex
+    pin: a URL alone is provenance, not authority. The body streams into a
+    TMPDIR staging file (``tempfile`` honours TMPDIR), is hashed as it lands,
+    and reaches ``path`` only after the digest matches. Any failure unlinks
+    the staging file and leaves ``path`` absent. Returns the receipt record
+    (final URL after redirects, hops, byte count, digest), with every URL
+    reduced by ``redact_url`` so tokens stay out of the receipt. Preconditions
+    are refused rather than repaired: an existing target is never clobbered.
+    """
+    if not isinstance(expected_sha, str) or not _HEX64_RE.fullmatch(
+            expected_sha):
+        raise SetupError('model-fetch-no-pin')
+    scheme = urllib.parse.urlsplit(url).scheme.lower()
+    if scheme not in MODEL_FETCH_SCHEMES:
+        raise SetupError(f'model-fetch-scheme:{scheme or "none"}')
+    if os.path.exists(path):
+        raise SetupError(f'model-fetch-target-exists:{path}')
+    parent = os.path.dirname(os.path.abspath(path))
+    if not os.path.isdir(parent):
+        raise SetupError(f'model-fetch-parent-missing:{parent}')
+    redirects = _FetchRedirects()
+    opener = urllib.request.build_opener(redirects)
+    fd, staged = tempfile.mkstemp(prefix='kama-model-fetch-', suffix='.part')
+    digest = hashlib.sha256()
+    size = 0
+    try:
+        with os.fdopen(fd, 'wb') as out:
+            try:
+                with opener.open(url, timeout=MODEL_FETCH_TIMEOUT) as response:
+                    status = getattr(response, 'status', None)
+                    if status is not None and status != 200:
+                        raise SetupError(f'model-fetch-http:{status}')
+                    while True:
+                        chunk = response.read(MODEL_FETCH_CHUNK)
+                        if not chunk:
+                            break
+                        digest.update(chunk)
+                        out.write(chunk)
+                        size += len(chunk)
+                    final_url = response.geturl()
+            except SetupError:
+                raise
+            except urllib.error.HTTPError as exc:
+                raise SetupError(f'model-fetch-http:{exc.code}') from exc
+            except (urllib.error.URLError, OSError, ValueError) as exc:
+                raise SetupError(
+                    f'model-fetch-open:{type(exc).__name__}') from exc
+            out.flush()
+            os.fsync(out.fileno())
+        got = digest.hexdigest()
+        if got.lower() != expected_sha.lower():
+            raise SetupError(f'model-fetch-digest-mismatch:{got}')
+        try:
+            _publish_model(staged, path)
+        except OSError as exc:
+            raise SetupError(
+                f'model-fetch-publish:{type(exc).__name__}') from exc
+    except BaseException:
+        try:
+            os.unlink(staged)
+        except OSError:
+            pass
+        raise
+    return {
+        'url': redact_url(url),
+        'url_final': redact_url(final_url),
+        'url_redacted': (redact_url(url) != url
+                         or redact_url(final_url) != final_url),
+        'redirects': [redact_url(hop) for hop in redirects.hops],
+        'bytes': size,
+        'sha256': got,
+    }
+
