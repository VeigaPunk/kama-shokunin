+def git_env(**extra):
+    """Scrubbed environment for git: no inherited GIT_* variables and no
+    user/system config (commit.gpgsign, core.hooksPath), so neither the
+    audited repos nor the selftest fixtures can be redirected."""
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
