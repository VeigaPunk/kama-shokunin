# H2: does `git worktree list --porcelain` enumerate a --detach linked worktree, and
#     is that worktree's dirt invisible to the primary but visible via its own status?

$ git -C /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/primary init -q
  (no output)
[exit=0]
$ git -C /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/primary rev-parse --show-toplevel
  /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/primary
[exit=0]
[assert ok: fixture root == toplevel]
write /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/primary/file.txt <- 'one\n'
$ git -C /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/primary add -A
  (no output)
[exit=0]
$ git -C /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/primary -c user.name=fixture -c user.email=fixture@invalid commit -q -m 'primary base'
  (no output)
[exit=0]

-- create the linked worktree with --detach --
$ git -C /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/primary worktree add --detach /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/linked HEAD
  HEAD is now at 612cb5a primary base
  stderr| Preparing worktree (detached HEAD 612cb5a)
[exit=0]
$ git -C /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/linked rev-parse --show-toplevel
  /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/linked
[exit=0]
[assert ok: fixture root == toplevel]

[1] enumeration from the primary
