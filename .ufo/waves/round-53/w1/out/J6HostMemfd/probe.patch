+            hm.update(chunk)
+            off += len(chunk)
+        if hm.hexdigest() != want:
+            raise Refused(f"memfd-content-mismatch:want={want}:got={hm.hexdigest()}")
+    except BaseException:
+        os.close(fd)
+        raise
