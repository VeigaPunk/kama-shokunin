+def swap_library(tree, server_member, libname, delta):
+    """J2SwapUnchecked (round-53 C1 ablation): rewrite one byte inside the first PT_LOAD
+    with the execute flag of an unpacked library, `delta` bytes into the segment's file
+    range, after the server member was checked and before the live tool loads libraries
+    from the tree. libggml-rpc.so is mapped by the loader but never executed on the CPU
+    inference path, so the server still starts."""
+    path = os.path.join(tree, os.path.dirname(server_member), libname)
+    with open(path, "r+b") as fh:
+        data = fh.read()
+        if data[:4] != b"\x7fELF":
+            raise Refused(f"swap-not-elf:{libname}")
+        e_phoff, = struct.unpack_from("<Q", data, 0x20)
+        e_phentsize, e_phnum = struct.unpack_from("<HH", data, 0x36)
+        off = None
+        for i in range(e_phnum):
+            base = e_phoff + i * e_phentsize
+            p_type, = struct.unpack_from("<I", data, base)
+            if p_type != 1:                                 # PT_LOAD
+                continue
+            p_flags, = struct.unpack_from("<I", data, base + 4)
+            p_offset, = struct.unpack_from("<Q", data, base + 8)
+            p_filesz, = struct.unpack_from("<Q", data, base + 32)
+            if p_flags & 1 and p_filesz > delta:            # PF_X
+                off = p_offset + delta
+                break
+        if off is None:
+            raise Refused(f"swap-no-exec-segment:{libname}")
+        fh.seek(off)
+        b = fh.read(1)
+        fh.seek(off)
+        fh.write(bytes([b[0] ^ 0xff]))
+
