[
  {
    "name": "LoadingEnvelope.canonical-alias",
    "family": "LoadingEnvelope",
    "why": "Byte-exact llama.cpp b11755 loading wire body on /v1/models (and /health, which the not-ready middleware answers identically); the alias expect is irrelevant because a loading server serves no id yet.",
    "port_mode": "stub",
    "routes": {
      "/v1/models": {
        "status": 503,
        "headers": {"Content-Type": "application/json; charset=utf-8", "Server": "llama.cpp"},
        "body_text": "{\"error\":{\"message\":\"Loading model\",\"type\":\"unavailable_error\",\"code\":503}}"
      },
      "/health": {
        "status": 503,
        "headers": {"Content-Type": "application/json; charset=utf-8", "Server": "llama.cpp"},
        "body_text": "{\"error\":{\"message\":\"Loading model\",\"type\":\"unavailable_error\",\"code\":503}}"
      }
    },
    "default_route": {
      "status": 503,
      "headers": {"Content-Type": "application/json; charset=utf-8", "Server": "llama.cpp"},
      "body_text": "{\"error\":{\"message\":\"Loading model\",\"type\":\"unavailable_error\",\"code\":503}}"
    },
    "expect": "stories260K",
    "expected": {"verdict": "MODEL_LOADING", "reason": "llamacpp-loading", "exit": 2}
  },
