+    "chat-peg-parser.cpp": "895755d892a759fdf96c9c5b67202f2201228d286ddfe1b7b699d07f063cebec",
+    "chat.cpp": "3793510ff80015d575777f01f9edcf8a58d859188d4f988190a02c50763bab49",
