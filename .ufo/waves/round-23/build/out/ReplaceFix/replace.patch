+# --no-replace-objects (git(1)): object lookups and history walks read the
+# committed objects, not refs/replace/* substitutes. git exports the same
+# setting to the processes it starts. Grafts are not covered: refuse_grafts().
+GIT_ISOLATION = ("--no-replace-objects",)
+
+
 def git_env(**extra):
-    """No inherited GIT_* variables and no user/system config, so neither
-    the audited repos nor the selftest fixtures can be redirected."""
+    """No inherited GIT_* variables and no user/system config, so the
+    environment cannot redirect the audited repos or the selftest fixtures.
+    Replace refs are ignored by git() (GIT_ISOLATION) and grafts are refused
+    by refuse_grafts(). GIT_NO_REPLACE_OBJECTS mirrors GIT_ISOLATION for any
+    process started with this environment."""
     env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
-    env.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1", **extra)
+    env.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1",
+               GIT_NO_REPLACE_OBJECTS="1", **extra)
