-- dirty the linked worktree (one modified tracked file, one untracked file) --
append /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/linked/file.txt <- 'dirt\n'
write /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/linked/untracked.txt <- 'new\n'

[3] primary status --porcelain -uall
$ git -C /fast/scratch/hyaku/kama-r73/LAB01Probes/h2/primary status --porcelain -uall
  (no output)
