+HOST_SERVER = "/home/vgpnk/.local/opt/llama-b11909/llama-server"
+
+
+def hardlink_member(work, server, want, res):
+    """Round 52 control (seat J4Hardlink, the round-51 shape): replace the digest-checked
+    extracted member at <work>/server/<member> with a hardlink to the host's byte-identical
+    b11909 install, so the live tool execs the member path and the running image is that
+    hardlink. A hardlink needs one filesystem: when <work> is elsewhere (EXDEV) a
+    byte-identical copy is staged under <work> and that copy is hardlinked at the member
+    path (same link count and bytes, the round-51 J4Hardlink decoy). Returns the identity
+    recorded as `own_server`; raises Refused when the linked bytes are not the receipt's
+    server."""
+    source = "host-hardlink"
+    os.unlink(server)
+    try:
+        os.link(HOST_SERVER, server)
+    except OSError as exc:
+        staged = os.path.join(work, "staged-host-server")
+        shutil.copy2(HOST_SERVER, staged)
+        os.link(staged, server)
+        source = f"staged-hardlink:{exc.errno}:{exc.strerror}"
+        res["inputs"]["hardlink_fallback"] = source
+    got = sha256_file(server)
+    if got != want:
+        raise Refused(f"hardlink-digest-mismatch:want={want}:got={got}")
+    st = os.stat(server)
+    return {"memfd": False, "member": os.path.basename(server), "sha256": got, "seals": None,
+            "source": source, "nlink": st.st_nlink,
+            "dev": "%02x:%02x" % (os.major(st.st_dev), os.minor(st.st_dev)), "inode": str(st.st_ino)}
+
