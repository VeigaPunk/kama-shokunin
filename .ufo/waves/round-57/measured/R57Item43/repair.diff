+def bind(a, tip, reported):
+    """Bind a declared maxN to the tree, refusing a stale literal or an unwitnessed claim.
+
+    A declaration is accepted only when it equals the value derived from the
+    SCORECARD headings at --tip, the counter's own reported value equals that
+    derivation (an executed read, not a literal), and a claim file states a
+    nonzero read witness. Returns True when bound.
+    """
+    declared, witness, source = a.expect_maxn, None, "--expect-maxn"
+    try:
+        if a.claim:
+            with open(a.claim, encoding="utf-8", errors="replace") as f:
+                text = f.read()
+            m = re.search(r"maxN=(\d+)", text)
+            witnesses = [int(x) for x in re.findall(
+                r"(?:self_description_reads|canonical_table_reads|reads)=(\d+)", text)]
+            declared = int(m.group(1)) if m else None
+            witness = max(witnesses) if witnesses else 0
+            source = a.claim
+        derived, headings = derive_maxn(show(os.path.abspath(a.repo), tip, "SCORECARD.md") or "")
+    except (OSError, ValueError) as e:
+        print(f"could-not-evaluate: {e}", file=sys.stderr)
+        return False
+    match = declared == derived
+    witnessed = witness is None or witness > 0
+    executed = reported == derived
+    ok = match and witnessed and executed
+    line = (f"bind: source={source} declared_maxn={declared} derived_maxn={derived} "
+            f"headings={headings} reported_maxn={reported} witness={witness} "
+            f"maxn_match={int(match)} witnessed={int(witnessed)} executed={int(executed)} "
+            f"met={ok}")
+    sys.stdout.write(line + "\n")
+    if a.out:
+        with open(a.out, "a") as f:
+            f.write(line + "\n")
+    return ok
+
+
