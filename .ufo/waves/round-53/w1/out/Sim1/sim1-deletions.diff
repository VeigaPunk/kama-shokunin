+def _hash_fd(fd, size):
+    """(sha256 of the first `size` bytes of an open fd, the bytes it fell short by) - one
+    reader for the three record-time digests on an fstat()-checked descriptor: the model
+    (model_mapping), the running image (/proc/<pid>/exe) and each mapped library."""
+    h, left = hashlib.sha256(), size
