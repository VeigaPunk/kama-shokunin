[
  {
    "name": "RouterStatus.loaded-single",
    "family": "RouterStatus",
    "why": "Router entry for the expected id carries status.value=loaded: the frozen rule leaves MODEL_OK/matched unchanged.",
    "port_mode": "stub",
    "routes": {
      "/v1/models": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body_json": {"object": "list", "data": [{"id": "stories260K", "object": "model", "status": {"value": "loaded", "failed": false, "args": []}}]}
      }
    },
    "default_route": null,
    "expect": "stories260K",
    "expected": {"verdict": "MODEL_OK", "reason": "matched", "exit": 0}
  },
