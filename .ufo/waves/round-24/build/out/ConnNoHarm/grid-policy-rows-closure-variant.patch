+def _marked(tmp):
+    """Complete lane carrying promisor metadata only: every object it needs
+    is local. `remote.origin.url` names a path that does not exist, so a
+    lazy fetch could not reach a transport even if the isolation flag were
+    removed."""
+    lane, fleet, lc = base(tmp)
+    g(lane, "config", "core.repositoryformatversion", "1")
+    g(lane, "config", "extensions.partialclone", "origin")
+    g(lane, "config", "remote.origin.url", str(Path(tmp, "absent.git")))
+    g(lane, "config", "remote.origin.promisor", "true")
+    g(lane, "config", "remote.origin.partialclonefilter", "blob:none")
+    return lane, fleet, lc
+
+
+def c_marked_clean(tmp):
+    """r24 policy: promisor metadata alone must not refuse a complete
+    repository; the verdict equals the identical full clone's (exit 0)."""
+    lane, fleet, _ = _marked(tmp)
+    return lane, fleet, [], None
+
+
+def c_marked_omission(tmp):
+    """r24 policy: a genuine omitted pre-cutoff commit in a marked but
+    complete lane is still a landed-omitted finding (exit 1)."""
+    lane, fleet, _ = _marked(tmp)
+    commit(lane, "kama-shokunin", 1500, "round-1: more")
+    return lane, fleet, [], None
+
+
+def c_marked_missing_citation(tmp):
+    """A citation missing everywhere in a promisor-marked store whose
+    selected roots are complete locally: the expectation is policy
+    dependent (exit 2 unknown, or exit 1 proved absence)."""
+    lane, fleet, lc = _marked(tmp)
+    publish(fleet, report([lc]) + b"\n## Notes\n\nsee " + FAKE.encode() + b"\n")
+    return lane, fleet, [], None
+
+
+def c_unmarked_missing_citation(tmp):
+    """remote.origin.promisor=false: the store is not promisor-backed, so a
+    missing citation stays a proved absence (exit 1)."""
+    lane, fleet, lc = base(tmp)
+    g(lane, "config", "remote.origin.promisor", "false")
+    publish(fleet, report([lc]) + b"\n## Notes\n\nsee " + FAKE.encode() + b"\n")
+    return lane, fleet, [], None
+
+
+def c_orphan_marker_missing_citation(tmp):
+    """An orphan .promisor marker without a paired .pack is not a promisor
+    store: a missing citation stays a proved absence (exit 1)."""
+    lane, fleet, lc = base(tmp)
+    Path(lane, ".git/objects/pack").mkdir(parents=True, exist_ok=True)
+    Path(lane, ".git/objects/pack/pack-deadbeef.promisor").write_bytes(b"")
+    publish(fleet, report([lc]) + b"\n## Notes\n\nsee " + FAKE.encode() + b"\n")
+    return lane, fleet, [], None
+
+
+def c_marked_wrongtype_citation(tmp):
+    """A locally present blob cited as a Landed commit stays a real failed
+    finding (exit 1): git answers a wrong-type peel as "missing", so an
+    unknown-absence rule must not swallow it."""
+    lane, fleet, lc = _marked(tmp)
+    blob = g(lane, "rev-parse", f"{lc}:f")
+    publish(fleet, report([lc, blob]))
+    return lane, fleet, [], None
+
+
+def c_marked_cross_repo_citation(tmp):
+    """A citation absent from the marked lane but present in the fleet is
+    resolved, not unknown (exit 0): absence is decided after every audited
+    repository has been consulted."""
+    lane, fleet, lc = _marked(tmp)
+    seed = commit(fleet, "fleet", 500, "seed", "seed.md", b"seed\n")
+    publish(fleet, report([lc]) + b"\n## Notes\n\nsee " + seed.encode() + b"\n")
+    return lane, fleet, [], None
+
+
+def c_incomplete_closure(tmp):
+    """A promisor-marked store whose selected roots' closure is incomplete
+    locally (the only blob is filtered out and never checked out): the
+    unavailable required object is a could-not-evaluate (exit 2) even when
+    every citation resolves."""
