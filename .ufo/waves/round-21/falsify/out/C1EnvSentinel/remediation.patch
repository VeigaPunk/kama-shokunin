+def assert_plain_repo(repo):
+    """Refuse a path that is not a repository's top level, or a repository whose
+    own state (shallow boundary, grafts, object alternates) changes which commits
+    the audit can see."""
+    if Path(git(repo, "rev-parse", "--show-toplevel").strip()).resolve() != repo:
+        raise EvalError(f"{repo}: not a repository top level")
+    if git(repo, "rev-parse", "--is-shallow-repository").strip() != "false":
+        raise EvalError(f"{repo}: shallow repository")
+    for item in ("objects/info/alternates", "info/grafts"):
+        if (repo / git(repo, "rev-parse", "--git-path", item).strip()).exists():
+            raise EvalError(f"{repo}: {item} present")
+
