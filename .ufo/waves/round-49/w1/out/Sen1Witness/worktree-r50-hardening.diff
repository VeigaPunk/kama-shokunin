+def _released(release, announced_ns):
+    """Round 49 host-safety (seat Sen1Witness F2 residual): only a regular file
+    created after this run's announcement releases the hold. os.path.exists also
+    accepted a directory or FIFO, and a release planted between
+    prepare_witness_dir() and the announcement ended the hold at once
+    (witness.released true with waited_ms 0 and nothing observed)."""
+    try:
+        st = os.lstat(release)
+    except OSError:
+        return False
+    return stat.S_ISREG(st.st_mode) and st.st_mtime_ns >= announced_ns
+
