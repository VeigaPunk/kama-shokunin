+def flags(text):
+    """The counter's second line as a dict: bind=1 code=0 coderuns=0/3 rehash=3 ..."""
+    lines = text.splitlines()
+    out = {}
+    for tok in (lines[1] if len(lines) > 1 else "").split():
+        if "=" in tok:
+            k, v = tok.split("=", 1)
+            out[k] = v
+    return out
+
