-    try:
-        tip = repo.commit(o.tip)
-        if tip is None:
-            raise RuntimeError(f"tip {o.tip} unresolved")
-        receipt["tip"] = tip
-        stmts = []
-        for f in FILES:
-            stmts += extract(repo, f)
-        sids = [s["sid"] for s in stmts]
-        if len(set(sids)) != len(sids):
