+++ /fast/scratch/hyaku/kama-r52/X6Rerun/diag.py	2026-10-27 02:12:55.378767756 -0300
@@ -478,6 +478,9 @@
                 ok = False
         else:
             corr += n
+            if os.environ.get("X6DEBUG") and f.endswith("SCORECARD.md"):
+                print(f"DBG {c[:12]} {f} own_unheld {n} ledger {sum(led.get((c,f),{}).values())} "
+                      f"keys_unheld {dict(list(un.items()))|{}} ledger_keys {dict(led.get((c,f),{}))}", flush=True)
             if n:
                 corr_files[f] += n
             if led.get((c, f)):

