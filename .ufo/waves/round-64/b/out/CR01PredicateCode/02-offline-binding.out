baseline all-true: True []
future mtime -> hold_fresh True
holder started same tick as tool -> hold_fresh True
extra --lora argv -> bind_argv True
LLAMA_ARG_* env -> bind_env True
/usr/lib/libevil.so unhashed -> bind_maps True
no holders + future mtime -> hold_fresh False
schema v2 hold -> hold_fresh False
--flag=value form -> bind_argv True
