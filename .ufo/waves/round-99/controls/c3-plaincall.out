# command: python3 .ufo/waves/round-99/controls/plaincall_harness.py --probe <probe> --label <base|candidate> --work /fast/scratch/hyaku/kama-r99/plaincall
--- base (git show 439fdb3d:tools/kama-probe.sh)
PLAINCALL base nonrouter verdict=MODEL_UNLOADED reason=router-unloaded rc=0 want=MODEL_UNLOADED/router-unloaded ok=1
PLAINCALL base off verdict=MODEL_UNLOADED reason=router-unloaded rc=0 want=MODEL_UNLOADED/router-unloaded ok=1
PLAINCALL base on verdict=MODEL_OK reason=router-unloaded-autoload rc=0 want=MODEL_OK/router-unloaded-autoload ok=1
base_exit=0
--- candidate (fixed call shape)
PLAINCALL candidate nonrouter verdict=MODEL_UNLOADED reason=router-autoload-unread rc=0 want=MODEL_UNLOADED/router-autoload-unread ok=1
PLAINCALL candidate off verdict=MODEL_UNLOADED reason=router-unloaded rc=0 want=MODEL_UNLOADED/router-unloaded ok=1
PLAINCALL candidate on verdict=MODEL_OK reason=router-unloaded-autoload rc=0 want=MODEL_OK/router-unloaded-autoload ok=1
cand_exit=0
