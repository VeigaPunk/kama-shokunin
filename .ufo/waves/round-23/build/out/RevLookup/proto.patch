+def object_is_genuine(repo, oid):
+    """cat-file trusts loose headers and never re-hashes bytes; a name
+    counts only when its bytes hash to it."""
+    import hashlib
+    proc = subprocess.run(["git", *GIT_ISOLATION, "-C", str(repo), "cat-file",
+                           "--batch"], input=f"{oid}\n".encode(),
+                          capture_output=True, env=git_env())
+    head, _, rest = proc.stdout.partition(b"\n")
+    fields = head.decode(errors="replace").split(" ")
+    if proc.returncode != 0 or len(fields) != 3:
+        return False
+    kind, size = fields[1], fields[2]
+    body = rest[:int(size)]
+    return hashlib.sha1(f"{kind} {size}\0".encode() + body).hexdigest() == oid
+
+
