+def mount_dev(path):
+    """major:minor of the mount holding path (mountinfo field 3), formatted as /proc/<pid>/maps
+    prints a file's device. btrfs reports the superblock device there while stat() returns the
+    subvolume's anonymous device, so for one and the same file a maps dev can equal this and not
+    st_dev (round-51 seat J4Hardlink: maps 00:1e, stat 00:38, both on the counter's own model)."""
+    best, out = "", None
+    try:
+        with open("/proc/self/mountinfo") as fh:
+            for line in fh:
+                f = line.split()
+                if len(f) < 5:
+                    continue
+                mp = f[4].replace("\\040", " ")
+                if (path == mp or path.startswith(mp.rstrip("/") + "/")) and len(mp) > len(best):
+                    maj, _, mino = f[2].partition(":")
+                    best, out = mp, "%02x:%02x" % (int(maj), int(mino))
+    except (OSError, ValueError):
+        return None
+    return out
+
