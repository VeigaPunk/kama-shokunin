+def _forge_connect(path):
+    for _ in range(300):
+        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        try:
+            c.connect(path)
+            c.settimeout(30)
+            return c
+        except OSError:
+            c.close()
+            time.sleep(0.05)
+    raise RuntimeError('control socket unreachable: ' + path)
