+TERM_GRACE = 10.0
+
+
+class StopRequested(Exception):
+    """A stop signal (or Ctrl-C) arrived while the live child was running."""
+
+
+def _pdeathsig():
+    """Child-side of the replay chain (round 49, seat X1Kill): the live child is
+    SIGKILLed when this replay dies, so the live tool's own pdeathsig then drops
+    the server it holds. Without this, a SIGTERM/SIGKILLed replay leaves the live
+    tool and the announced llama-server bound to the witness port until the
+    witness timeout runs out."""
+    try:
+        import ctypes
+        libc = ctypes.CDLL(None, use_errno=True)
+        libc.prctl(1, signal.SIGKILL, 0, 0, 0)  # PR_SET_PDEATHSIG
+    except Exception:  # best effort hardening only
+        pass
+
+
+def _raise_stop(signum, _frame):
+    raise StopRequested(f"terminated:signal {signum}")
+
