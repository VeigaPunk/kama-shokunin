== field_num::eval @release server-schema.cpp
   602	template <typename T>
   603	void field_num<T>::eval(field_eval_context & ctx, const json & data) {
   604	    for (const auto & n : name) {
   605	        if (has_value(data, n)) {
   606	            handle_with_catch(n, [&]() {
   607	                if (custom_handler) {
   608	                custom_handler(ctx, data);
   609	                } else if (!is_hard_limit) {
   610	                    val = std::max(min, std::min(max, data.at(n).template get<T>()));
   611	                } else {
   612	                    T tmp = data.at(n).template get<T>();
   613	                    if (tmp < min || tmp > max) {
   614	                        throw std::invalid_argument(std::string("Value must be between ") + std::to_string(min) + " <= value <= " + std::to_string(max) + ", but got " + std::to_string(tmp));
   615	                    }
   616	                    val = tmp;
   617	                }
   618	            });
   619	            return;
   620	        }
   621	    }
   622	}
== field_num struct @release server-schema.h
    47	template <typename T = int32_t>
    48	struct field_num : public field {
    49	    T & val;
    50	    T min = std::numeric_limits<T>::lowest();
    51	    T max = std::numeric_limits<T>::max();
    52	    bool is_hard_limit = false; // if true, throw error if the value is invalid
    53	    field_num(const char * n, T & val) : field(n), val(val) {}
    54	    // limits are inclusive, min <= value <= max
    55	    field_num * set_limits(T min, T max) {
    56	        this->min = min;
    57	        this->max = max;
    58	        return this;
    59	    }
    60	    field_num * set_hard_limits(T min, T max) {
    61	        set_limits(min, max);
    62	        is_hard_limit = true;
    63	        return this;
    64	    }
    65	    virtual void eval(field_eval_context & ctx, const json & data) override;
    66	};
