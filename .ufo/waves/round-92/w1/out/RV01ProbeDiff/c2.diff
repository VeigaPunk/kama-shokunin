 # ---------------------------------------------------------------- json helpers
+# Round 92 (C2; r91 wave-1 SC02 F1): the escaping runs in ONE awk pass over the value, so its cost
+# is linear in the value's length. The former `${s//pat/repl}` global replacements cost O(length)
+# per match, so a served list of 1.9M backslashes (a legal 3.8 MB answer) ran past 180 s. The rule
+# is unchanged: `\` and `"` are escaped, TAB/LF/CR become \t \n \r, and every other control
+# character U+0001-U+001F and DEL becomes \u00XX (round 90, S588 RFC 8259 section 7). A value
+# with none of those bytes is printed as is (no fork); awk reads the value as LF-separated records
+# in the C locale, so a byte >= 0x80 passes through unchanged and LF is the record boundary.
+AWK_JSTR='BEGIN { for (i = 1; i < 32; i++) C[sprintf("%c", i)] = sprintf("\\u%04x", i)
+  C[sprintf("%c", 127)] = "\\u007f"; C["\t"] = "\\t"; C["\r"] = "\\r" }
+function piece(t,  n, k, c) {
+  if (t !~ /[\001-\037\177]/) { printf "%s", t; return }
+  n = length(t)
+  for (k = 1; k <= n; k++) { c = substr(t, k, 1); printf "%s", ((c in C) ? C[c] : c) }
+}
+function quotes(t,  n, q, j) {
+  n = split(t, q, "\""); piece(q[1])
+  for (j = 2; j <= n; j++) { printf "%s", "\\\""; piece(q[j]) }
+}
+NR > 1 { printf "%s", "\\n" }
+{ n = split($0, b, "\\"); quotes(b[1]); for (i = 2; i <= n; i++) { printf "%s", "\\\\"; quotes(b[i]) } }'
+
