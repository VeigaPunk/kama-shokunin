+    ("GET", "/health", None),
+    ("GET", "/v1/models", None),
+    ("GET", "/props", None),
+    ("GET", "/slots", None),
+    ("POST", "/completion", {"prompt": "Once upon a time", "n_predict": 8}),
+    ("POST", "/v1/chat/completions",
+     {"messages": [{"role": "user", "content": "Hi"}], "max_tokens": 8}),
